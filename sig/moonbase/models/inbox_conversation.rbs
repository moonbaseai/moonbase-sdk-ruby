module Moonbase
  module Models
    type inbox_conversation =
      {
        id: String,
        bulk: bool,
        channel: Moonbase::Models::InboxConversation::channel,
        created_at: Time,
        draft: bool,
        follow_up: bool,
        last_message_at: Time,
        spam: bool,
        state: Moonbase::Models::InboxConversation::state,
        subject: String,
        tags: ::Array[Moonbase::Tag],
        trash: bool,
        type: :inbox_conversation,
        unread: bool,
        updated_at: Time,
        inbox: Moonbase::Inbox,
        messages: ::Array[top],
        unsnooze_at: Time
      }

    class InboxConversation < Moonbase::Internal::Type::BaseModel
      attr_accessor id: String

      attr_accessor bulk: bool

      attr_accessor channel: Moonbase::Models::InboxConversation::channel

      attr_accessor created_at: Time

      attr_accessor draft: bool

      attr_accessor follow_up: bool

      attr_accessor last_message_at: Time

      attr_accessor spam: bool

      attr_accessor state: Moonbase::Models::InboxConversation::state

      attr_accessor subject: String

      attr_accessor tags: ::Array[Moonbase::Tag]

      attr_accessor trash: bool

      attr_accessor type: :inbox_conversation

      attr_accessor unread: bool

      attr_accessor updated_at: Time

      attr_reader inbox: Moonbase::Inbox?

      def inbox=: (Moonbase::Inbox) -> Moonbase::Inbox

      attr_reader messages: ::Array[top]?

      def messages=: (::Array[top]) -> ::Array[top]

      attr_reader unsnooze_at: Time?

      def unsnooze_at=: (Time) -> Time

      def initialize: (
        id: String,
        bulk: bool,
        channel: Moonbase::Models::InboxConversation::channel,
        created_at: Time,
        draft: bool,
        follow_up: bool,
        last_message_at: Time,
        spam: bool,
        state: Moonbase::Models::InboxConversation::state,
        subject: String,
        tags: ::Array[Moonbase::Tag],
        trash: bool,
        unread: bool,
        updated_at: Time,
        ?inbox: Moonbase::Inbox,
        ?messages: ::Array[top],
        ?unsnooze_at: Time,
        ?type: :inbox_conversation
      ) -> void

      def to_hash: -> {
        id: String,
        bulk: bool,
        channel: Moonbase::Models::InboxConversation::channel,
        created_at: Time,
        draft: bool,
        follow_up: bool,
        last_message_at: Time,
        spam: bool,
        state: Moonbase::Models::InboxConversation::state,
        subject: String,
        tags: ::Array[Moonbase::Tag],
        trash: bool,
        type: :inbox_conversation,
        unread: bool,
        updated_at: Time,
        inbox: Moonbase::Inbox,
        messages: ::Array[top],
        unsnooze_at: Time
      }

      type channel = :email | :chat | :slack

      module Channel
        extend Moonbase::Internal::Type::Enum

        EMAIL: :email
        CHAT: :chat
        SLACK: :slack

        def self?.values: -> ::Array[Moonbase::Models::InboxConversation::channel]
      end

      type state = :unassigned | :active | :closed | :waiting

      module State
        extend Moonbase::Internal::Type::Enum

        UNASSIGNED: :unassigned
        ACTIVE: :active
        CLOSED: :closed
        WAITING: :waiting

        def self?.values: -> ::Array[Moonbase::Models::InboxConversation::state]
      end
    end
  end
end
