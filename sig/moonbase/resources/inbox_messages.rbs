module Moonbase
  module Resources
    class InboxMessages
      attr_reader attachments: Moonbase::Resources::InboxMessages::Attachments

      def create: (
        message: Moonbase::Models::InboxMessageCreateParams::message,
        ?request_options: Moonbase::request_opts
      ) -> Moonbase::Models::inbox_message_create_response

      def retrieve: (
        String id,
        ?include: ::Array[Moonbase::Models::InboxMessageRetrieveParams::include_],
        ?request_options: Moonbase::request_opts
      ) -> Moonbase::Models::inbox_message_retrieve_response

      def update: (
        String id,
        message: Moonbase::Models::InboxMessageUpdateParams::message,
        ?request_options: Moonbase::request_opts
      ) -> Moonbase::Models::inbox_message_update_response

      def list: (
        ?after: String,
        ?before: String,
        ?conversation_id: Moonbase::InboxMessageListParams::ConversationID,
        ?inbox_id: Moonbase::InboxMessageListParams::InboxID,
        ?limit: Integer,
        ?request_options: Moonbase::request_opts
      ) -> Moonbase::Internal::CursorPage[Moonbase::MessagePointer]

      def delete: (String id, ?request_options: Moonbase::request_opts) -> nil

      def initialize: (client: Moonbase::Client) -> void
    end
  end
end
